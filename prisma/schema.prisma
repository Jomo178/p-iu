// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts_web")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions_web")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  discordId     String?   @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users_web")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
  @@map("verificationtokens_web")
}

model Staff {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  discordId String              @unique
  role      StaffRole
  create    AuthorizationType[] @default([])
  edit      AuthorizationType[] @default([])
  delete    AuthorizationType[] @default([])
  handle    AuthorizationType[] @default([])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  createdPendingIssues  PendingIssues[] @relation("PendingIssuesCreatedBy")
  approvedPendingIssues PendingIssues[] @relation("PendingIssuesApprovedBy")
  createdPendingFrames  PendingFrames[] @relation("PendingFramesCreatedBy")
  approvedPendingFrames PendingFrames[] @relation("PendingFramesApprovedBy")
  createdPendingFonts   PendingFonts[]  @relation("PendingFontsCreatedBy")
  approvedPendingFonts  PendingFonts[]  @relation("PendingFontsApprovedBy")
  rejectedResubmissions Rejections[]    @relation("RejectionsResubmittedBy")
  rejections            Rejections[]    @relation("RejectionsRejectedBy")
  events                Events[]        @relation("EventsCreatedBy")
  createdIssues         Issues[]        @relation("IssuesCreatedBy")
  approvedIssues        Issues[]        @relation("IssuesApprovedBy")
  createdFrames         Frames[]        @relation("FramesCreatedBy")
  approvedFrames        Frames[]        @relation("FramesApprovedBy")
  createdFonts          Fonts[]         @relation("FontsCreatedBy")
  approvedFonts         Fonts[]         @relation("FontsApprovedBy")

  @@map("staff")
}

enum StaffRole {
  developer
  headCardCreator
  cardCreator
  supporter
  designer
}

enum AuthorizationType {
  staff
  frames
  issues
  fonts
  event
}

model PendingIssues {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  group        String
  act          String
  rarity       Int
  code         String    @unique
  image        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  eventId      String    @db.ObjectId
  createdById  String    @db.ObjectId
  approvedById String?   @db.ObjectId
  approvedAt   DateTime?
  dropAble     Boolean   @default(true)

  rejections Rejections[] @relation("RejectionsPendingIssue")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingIssuesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingIssuesCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingIssuesApprovedBy")

  @@map("pendingissues")
}

model Issues {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  group        String
  act          String
  rarity       Int
  code         String   @unique
  image        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eventId      String   @db.ObjectId
  createdById  String   @db.ObjectId
  approvedById String   @db.ObjectId
  approvedAt   DateTime
  dropAble     Boolean  @default(true)

  rejections Rejections[] @relation("RejectionsIssue")
  event      Events       @relation(fields: [eventId], references: [id], name: "IssuesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "IssuesCreatedBy")
  approvedBy Staff        @relation(fields: [approvedById], references: [id], name: "IssuesApprovedBy")

  @@map("issues")
}

model PendingFrames {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rarity       FrameRarity
  code         String      @unique
  image        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eventId      String      @db.ObjectId
  createdById  String      @db.ObjectId
  approvedById String?     @db.ObjectId
  approvedAt   DateTime?
  dropAble     Boolean     @default(true)

  rejections Rejections[] @relation("RejectionsPendingFrame")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingFramesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingFramesCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingFramesApprovedBy")

  @@map("pendingframes")
}

model Frames {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rarity       FrameRarity
  code         String      @unique
  image        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eventId      String      @db.ObjectId
  createdById  String      @db.ObjectId
  approvedById String      @db.ObjectId
  approvedAt   DateTime
  dropAble     Boolean     @default(true)

  rejections Rejections[] @relation("RejectionsFrame")
  event      Events       @relation(fields: [eventId], references: [id], name: "FramesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "FramesCreatedBy")
  approvedBy Staff        @relation(fields: [approvedById], references: [id], name: "FramesApprovedBy")

  @@map("frames")
}

enum FrameRarity {
  Common
  Rare
  Special
}

model Fonts {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Int
  onMarket     Boolean
  isBig        Boolean
  short        String
  filePath     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String   @db.ObjectId
  approvedById String   @db.ObjectId
  approvedAt   DateTime
  eventId      String   @db.ObjectId

  rejections Rejections[] @relation("RejectionsFont")
  event      Events       @relation(fields: [eventId], references: [id], name: "FontsEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "FontsCreatedBy")
  approvedBy Staff        @relation(fields: [approvedById], references: [id], name: "FontsApprovedBy")

  @@map("fonts")
}

model PendingFonts {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Int
  onMarket     Boolean
  isBig        Boolean
  short        String
  filePath     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  eventId      String    @db.ObjectId
  createdById  String    @db.ObjectId
  approvedById String?   @db.ObjectId
  approvedAt   DateTime?

  rejections Rejections[] @relation("RejectionsPendingFont")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingFontsEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingFontsCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingFontsApprovedBy")

  @@map("pendingfonts")
}

model Events {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  type         PrismaEventTypes[]
  name         String             @unique
  start        DateTime
  end          DateTime
  customRarity String?
  createdById  String             @db.ObjectId
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy     Staff           @relation(fields: [createdById], references: [id], name: "EventsCreatedBy")
  issues        Issues[]        @relation("IssuesEvent")
  pendingIssues PendingIssues[] @relation("PendingIssuesEvent")
  frames        Frames[]        @relation("FramesEvent")
  pendingFrames PendingFrames[] @relation("PendingFramesEvent")
  fonts         Fonts[]         @relation("FontsEvent")
  pendingFonts  PendingFonts[]  @relation("PendingFontsEvent")

  @@map("events")
}

enum PrismaEventTypes {
  issues
  frames
  fonts
}

model Rejections {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  reason          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rejectedById    String    @db.ObjectId
  resubmitted     Boolean   @default(false)
  resubmittedAt   DateTime?
  resubmittedById String?   @db.ObjectId
  issuesId        String?   @db.ObjectId
  pendingIssuesId String?   @db.ObjectId
  framesId        String?   @db.ObjectId
  pendingFramesId String?   @db.ObjectId
  fontsId         String?   @db.ObjectId
  pendingFontsId  String?   @db.ObjectId

  rejectedBy    Staff          @relation(fields: [rejectedById], references: [id], name: "RejectionsRejectedBy")
  resubmittedBy Staff?         @relation(fields: [resubmittedById], references: [id], name: "RejectionsResubmittedBy")
  issues        Issues?        @relation(fields: [issuesId], references: [id], name: "RejectionsIssue")
  pendingIssues PendingIssues? @relation(fields: [pendingIssuesId], references: [id], name: "RejectionsPendingIssue")
  frames        Frames?        @relation(fields: [framesId], references: [id], name: "RejectionsFrame")
  pendingFrames PendingFrames? @relation(fields: [pendingFramesId], references: [id], name: "RejectionsPendingFrame")
  fonts         Fonts?         @relation(fields: [fontsId], references: [id], name: "RejectionsFont")
  pendingFonts  PendingFonts?  @relation(fields: [pendingFontsId], references: [id], name: "RejectionsPendingFont")

  @@map("rejections")
}
