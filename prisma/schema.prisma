// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts_web")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions_web")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  discordId     String?   @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users_web")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
  @@map("verificationtokens_web")
}

model Staff {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  discordId             String          @unique
  role                  Role
  create                Permission[]    @default([])
  edit                  Permission[]    @default([])
  delete                Permission[]    @default([])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdPendingIssues  PendingIssues[] @relation("PendingIssuesCreatedBy")
  approvedPendingIssues PendingIssues[] @relation("PendingIssuesApprovedBy")
  rejections            Rejections[]    @relation("RejectionsRejectedBy")
  rejectedResubmissions Rejections[]    @relation("RejectionsResubmittedBy")
  createdPendingFrames  PendingFrames[] @relation("PendingFramesCreatedBy")
  approvedPendingFrames PendingFrames[] @relation("PendingFramesApprovedBy")
  Events                Events[]        @relation("EventsCreatedBy")
  createdIssues         Issues[]        @relation("IssuesCreatedBy")
  approvedIssues        Issues[]        @relation("IssuesApprovedBy")

  @@map("staff")
}

enum Role {
  developer
  headCardCreator
  cardCreator
  supporter
  designer
}

enum Permission {
  staff
  frame
  issue
  event
}

model PendingIssues {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  group        String
  act          String
  rarity       Int
  code         String    @unique
  image        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  eventId      String    @db.ObjectId
  createdById  String    @db.ObjectId
  approvedById String?   @db.ObjectId
  approvedAt   DateTime?
  dropAble     Boolean   @default(true)

  rejections Rejections[] @relation("RejectionsPendingIssue")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingIssuesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingIssuesCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingIssuesApprovedBy")

  @@map("pendingissues")
}

model Issues {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  group        String
  act          String
  rarity       Int
  code         String   @unique
  image        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eventId      String?  @db.ObjectId
  createdById  String   @db.ObjectId
  approvedById String   @db.ObjectId
  approvedAt   DateTime
  dropAble     Boolean  @default(true)

  rejections Rejections[] @relation("RejectionsIssue")
  event      Events?      @relation(fields: [eventId], references: [id], name: "IssuesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "IssuesCreatedBy")
  approvedBy Staff        @relation(fields: [approvedById], references: [id], name: "IssuesApprovedBy")

  @@map("issues")
}

model PendingFrames {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rarity       FrameRarity
  code         String      @unique
  image        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eventId      String      @db.ObjectId
  createdById  String      @db.ObjectId
  approvedById String?     @db.ObjectId
  approvedAt   DateTime?
  dropAble     Boolean     @default(true)

  rejections Rejections[] @relation("RejectionsPendingFrame")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingFramesEvent")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingFramesCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingFramesApprovedBy")

  @@map("pendingframes")
}

enum FrameRarity {
  Common
  Rare
  Special
}

model Events {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  type          EventType[]
  name          String          @unique
  start         DateTime
  end           DateTime
  customRarity  String?
  createdById   String          @db.ObjectId
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     Staff           @relation(fields: [createdById], references: [id], name: "EventsCreatedBy")
  pendingIssues PendingIssues[] @relation("PendingIssuesEvent")
  pendingFrames PendingFrames[] @relation("PendingFramesEvent")
  Issues        Issues[]        @relation("IssuesEvent")

  @@map("events")
}

enum EventType {
  issues
  frames
}

model Rejections {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  reason          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rejectedById    String    @db.ObjectId
  resubmitted     Boolean   @default(false)
  resubmittedAt   DateTime?
  resubmittedById String?   @db.ObjectId
  pendingIssuesId String?   @db.ObjectId
  issuesId        String?   @db.ObjectId
  pendingFramesId String?   @db.ObjectId

  rejectedBy    Staff          @relation(fields: [rejectedById], references: [id], name: "RejectionsRejectedBy")
  resubmittedBy Staff?         @relation(fields: [resubmittedById], references: [id], name: "RejectionsResubmittedBy")
  pendingIssues PendingIssues? @relation(fields: [pendingIssuesId], references: [id], name: "RejectionsPendingIssue")
  pendingFrames PendingFrames? @relation(fields: [pendingFramesId], references: [id], name: "RejectionsPendingFrame")
  Issues        Issues?        @relation(fields: [issuesId], references: [id], name: "RejectionsIssue")

  @@map("rejections")
}
